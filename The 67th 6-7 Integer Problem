#include <iostream>
using namespace std;

int main() {
    int t;
    cin >> t;  

    while(t--) {
        int a[7], sum = 0, maxVal = -68;

        for(int i = 0; i < 7; i++) {
            cin >> a[i];
            sum += a[i];              
            if(a[i] > maxVal) maxVal = a[i]; 
        }

        cout << 2*maxVal - sum << endl; 
    }

    return 0;
}
