#include <iostream>
using namespace std;

int main() {
    long long n, k;
    cin >> n >> k;

    long long odd_count = (n + 1) / 2;

    if(k <= odd_count)
        cout << 2*k - 1 << endl;  // k-th odd number
    else
        cout << 2*(k - odd_count) << endl;  // (k-odd_count)-th even number

    return 0;

}
